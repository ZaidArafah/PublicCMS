@using PublicCMS.Core.Repositories
@using PublicCMS.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PublicCMS.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <a class="nav-link" href="swagger" target="_blank">
                <span class="oi oi-external-link" aria-hidden="true"></span> Mitt API (Swagger)
            </a>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Logga in
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="registrera">
                        <span class="bi bi-person-plus" aria-hidden="true"></span> Registrera dig
                    </NavLink>
                </div>
            </NotAuthorized>
            
            <Authorized>
                <div class="nav-item px-3 mt-3 mb-2 text-white-50">
                    <small class="ms-3">Inloggad som: <strong>@loggedInUserName</strong></small>
                </div>

                <div class="nav-item px-3">
                    <a class="nav-link text-danger" href="/api/logout">
                        <span class="bi bi-box-arrow-left" aria-hidden="true"></span> Logga ut
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>


        <div class="nav-item px-3">
            <NavLink class="nav-link" href="meddelanden">
                <span class="bi bi-envelope-fill-nav-menu" aria-hidden="true"></span> Meddelanden
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="forum">
                <span class="bi bi-chat-text" aria-hidden="true"></span> Forum
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <hr class="text-white-50 mx-3" />
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/anvandare">
                        <span class="bi bi-people" aria-hidden="true"></span> Alla användare
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/pages">
                        <span class="bi bi-list" aria-hidden="true"></span> Alla sidor
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/createpage">
                        <span class="bi bi-plus-square" aria-hidden="true"></span> Skapa inlägg
                    </NavLink>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/kategorier">
                            <span class="bi bi-tags" aria-hidden="true"></span> Hantera Forum
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/anmalningar">
                            <span class="bi bi-flag-fill-nav-menu" aria-hidden="true"></span> Anmälningar
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/anmalda-kommentarer">
                            <span class="bi bi-chat-dots" aria-hidden="true"></span> Anmälda kommentarer
                        </NavLink>
                    </div>
                </div>

            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {

    private string loggedInUserName = "";
    
    protected override async Task OnInitializedAsync()
    {   
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            loggedInUserName = authState.User.Identity.Name ?? "";
        }
    }
}