@page "/admin/anmalningar"
@using Microsoft.AspNetCore.Authorization
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@using PublicCMS.Web.Repositories
@attribute [Authorize(Roles = "Admin")]
@inject IReportedPostRepository ReportRepo
@inject IForumPostRepository PostRepo

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-flag-fill"></i> Granska anmälda inlägg</h2>
    <hr />

    @if (reports.Count == 0)
    {
        <div class="alert alert-success">Det finns inga anmälda inlägg just nu. Bra jobbat!</div>
    }
    else
    {
        <table class="table table-striped table-bordered mt-3 shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Anmäld av</th>
                    <th>Anledning</th> 
                    <th>Datum</th>
                    <th>Inlägg</th>
                    <th>Åtgärd</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in reports)
                {
                    <tr>
                        <td>@report.ReportedBy</td>
                        <td class="text-danger fw-bold">@report.Reason</td> 
                        <td>@report.ReportedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a href="/inlagg/@report.ForumPostId" target="_blank">Läs inlägget (ID: @report.ForumPostId)</a>
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm me-2 mb-1" @onclick="() => TaBortInlagg(report.ForumPostId, report.Id)">
                                Ta bort inlägg
                            </button>
                            <button class="btn btn-secondary btn-sm mb-1" @onclick="() => AvfardaAnmalan(report.Id)">
                                Avfärda anmälan
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ReportedPost> reports = new List<ReportedPost>();

    protected override void OnInitialized()
    {
        LaddaAnmalningar();
    }

    private void LaddaAnmalningar()
    {
        reports = ReportRepo.GetAllReports();
    }

    private void TaBortInlagg(int postId, int reportId)
    {
        PostRepo.Delete(postId);
        
        ReportRepo.DeleteReport(reportId);
        
        LaddaAnmalningar();
    }

    private void AvfardaAnmalan(int reportId)
    {
        ReportRepo.DeleteReport(reportId);
        LaddaAnmalningar();
    }
}