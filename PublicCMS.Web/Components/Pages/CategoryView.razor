@page "/kategori/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@using PublicCMS.Web.Repositories
@inject ICategoryRepository CategoryRepo
@inject IForumPostRepository PostRepo
@inject AuthenticationStateProvider AuthStateProvider
@using System.IO
@inject IWebHostEnvironment Env
@inject IReportedPostRepository ReportRepo

@if (category == null)
{
    <p>Laddar...</p>
}
else
{
    <div class="container mt-4">
        <h2>@category.Name</h2>
        <p class="text-muted">@category.Description</p>
        <hr />

        <div class="row">
            <!-- Vänster sida: Listan med inlägg -->
            <div class="col-md-8">
                <h4>Diskussioner</h4>
                @if (posts.Count == 0)
                {
                    <div class="alert alert-secondary">Inga inlägg ännu. Bli först med att skriva!</div>
                }
                else
                {
                    @foreach (var post in posts)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body d-flex">
                                <div class="me-3 text-center" style="width: 100px;">
                                    @if (!string.IsNullOrEmpty(post.AuthorProfileImageUrl))
                                    {
                                        <img src="@post.AuthorProfileImageUrl" style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="bi bi-person-circle" style="font-size: 3rem; color: #ccc;"></span>
                                    }
                                    <small class="d-block mt-1 fw-bold text-break">@post.AuthorName</small>
                                </div>
                                
                                <!-- själva inlägget -->
                                <div class="flex-grow-1">
                                    <small class="text-muted float-end">@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    <a href="/inlagg/@post.Id" class="text-decoration-none">
                                        <h5 class="card-title text-primary">@post.Title</h5>
                                    </a>
                                    <p class="card-text">@post.Content</p>

                                  
                                        <div class="mt-2">
                                            @if (currentUserName == post.AuthorName)
                                            {
                                                <a href="/redigera-inlagg/@post.Id" class="btn btn-sm btn-outline-primary me-2">
                                                    <i class="bi bi-pencil"></i> Redigera
                                                </a>
                                            }

                                            @if (isAdmin || currentUserName == post.AuthorName)
                                            {
                                                <button class="btn btn-sm btn-outline-danger me-2" @onclick="() => TaBortInlagg(post.Id)">
                                                    <i class="bi bi-trash"></i> Ta bort
                                                </button>
                                            }

                                            @if (!string.IsNullOrEmpty(currentUserName) && currentUserName != post.AuthorName)
                                            {
                                                @if (anmaldaInlagg.Contains(post.Id))
                                                {
                                                    <span class="text-success ms-2 fw-bold"><i class="bi bi-check-circle"></i> Anmälan skickad!</span>
                                                }
                                                else if (inlaggSomAnmals == post.Id)
                                                {
                                                    <div class="mt-2 p-2 border border-warning rounded bg-light d-inline-block">
                                                        <input @bind="anmalningsAnledning" class="form-control form-control-sm mb-2" placeholder="Varför anmäler du inlägget?" />
                                                        <button class="btn btn-sm btn-danger me-1" @onclick="() => SkickaAnmalan(post.Id)">Skicka</button>
                                                        <button class="btn btn-sm btn-secondary" @onclick="AvbrytAnmalan">Avbryt</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-warning text-dark ms-2" @onclick="() => BorjaAnmala(post.Id)">
                                                        <i class="bi bi-flag"></i> Anmäl
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                  
                    }
                }
            </div>

            <!-- höger sida för Skapa inlägg -->
            <div class="col-md-4">
                <AuthorizeView>
                    <Authorized>
                        <div class="card p-3 bg-light shadow-sm border-primary">
                            <h5>Skriv ett nytt inlägg</h5>
                            <div class="mb-2">
                                <label>Rubrik:</label>
                                <input @bind="newPost.Title" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label>Meddelande:</label>
                                <textarea @bind="newPost.Content" class="form-control" rows="4"></textarea>
                            </div>
                            
                            <div class="mb-3">
                                <label>Bifoga en bild (Frivilligt):</label>
                                <InputFile OnChange="LaddaUppBild" class="form-control" />
                            </div>

                            @if (!string.IsNullOrEmpty(newPost.ImageUrl))
                            {
                                <div class="mb-3 text-center">
                                    <img src="@newPost.ImageUrl" alt="Förhandsgranskning" style="max-width: 100%; border-radius: 8px;" />
                                </div>
                            }
                           
                            <button class="btn btn-primary w-100" @onclick="SparaInlagg">Publicera inlägg</button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="alert alert-warning">
                            Du måste <a href="/login">logga in</a> för att skapa ett inlägg.
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Category? category;
    private List<ForumPost> posts = new List<ForumPost>();
    private ForumPost newPost = new ForumPost();

    private string currentUserName = "";
    private bool isAdmin = false;

    protected override async Task OnParametersSetAsync()
    {
        category = CategoryRepo.GetAll().FirstOrDefault(c => c.Id == Id);
        LaddaInlagg();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            currentUserName = authState.User.Identity.Name ?? "";
            isAdmin = authState.User.IsInRole("Admin");
        }
    }

    private void LaddaInlagg()
    {
        posts = PostRepo.GetByCategoryId(Id);
    }

   
    private void TaBortInlagg(int id)
    {
        PostRepo.Delete(id);
        LaddaInlagg(); 
    }

    private async Task SparaInlagg()
    {
        if (string.IsNullOrWhiteSpace(newPost.Title) || string.IsNullOrWhiteSpace(newPost.Content))
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            newPost.CategoryId = Id;
            newPost.AuthorName = user.Identity.Name ?? "Okänd";
            
            var imageClaim = user.Claims.FirstOrDefault(c => c.Type == "ProfileImage");
            if (imageClaim != null)
            {
                newPost.AuthorProfileImageUrl = imageClaim.Value;
            }

            newPost.CreatedAt = DateTime.Now;

            PostRepo.Add(newPost);
            newPost = new ForumPost();
            LaddaInlagg();
        }
    }

    private async Task LaddaUppBild(InputFileChangeEventArgs e)
    {
        var fil = e.File;
        var filnamn = Guid.NewGuid().ToString() + Path.GetExtension(fil.Name);
        
        var mappSökväg = Path.Combine(Env.WebRootPath, "images");
        Directory.CreateDirectory(mappSökväg);
        var sökväg = Path.Combine(mappSökväg, filnamn);

        using var stream = new FileStream(sökväg, FileMode.Create);
        await fil.OpenReadStream(1024 * 1024 * 5).CopyToAsync(stream);

        newPost.ImageUrl = $"/images/{filnamn}";
    }
    private int? inlaggSomAnmals = null;
    private string anmalningsAnledning = "";
    private List<int> anmaldaInlagg = new List<int>();

    private void BorjaAnmala(int id)
    {
        inlaggSomAnmals = id;
        anmalningsAnledning = "";
    }

    private void AvbrytAnmalan()
    {
        inlaggSomAnmals = null;
    }

    private void SkickaAnmalan(int inlaggId)
    {
        if (string.IsNullOrWhiteSpace(anmalningsAnledning))
        {
            anmalningsAnledning = "Ingen anledning angiven";
        }

        var nyAnmalan = new ReportedPost
        {
            ForumPostId = inlaggId,
            ReportedBy = currentUserName,
            Reason = anmalningsAnledning,
            ReportedAt = DateTime.Now
        };
        
        ReportRepo.AddReport(nyAnmalan);
        
        anmaldaInlagg.Add(inlaggId);
        
        inlaggSomAnmals = null;
    }
}