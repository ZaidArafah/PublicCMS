@page "/sida/{Id:int}"
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@inject IPageRepository PageRepo

@if (currentPage == null)
{
    <p>Laddar sidan, eller så hittades den inte...</p>
}
else
{
    <h1>@currentPage.Title</h1>

    @if (!string.IsNullOrEmpty(currentPage.ImageUrl))
    {
        <img src="@currentPage.ImageUrl" alt="bild för sidan" class="img-fluid my-3" style="max-width: 500px"/>
    }

    <div class="mt-4">
        <p>@currentPage.Bodytext</p>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Page currentPage;

    protected override void OnInitialized()
    {
        currentPage = PageRepo.GetById(Id);
    }
}