@page "/meddelanden"
@using Microsoft.AspNetCore.Components.Authorization
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@using PublicCMS.Web.Repositories
@inject IPrivateMessageRepository MessageRepo
@inject AuthenticationStateProvider AuthStateProvider

<AuthorizeView>
    <Authorized>
        <div class="container mt-4">
            <h2>Mina Meddelanden</h2>
            <hr />

            <div class="row">
                <!-- Vänster sida: Skicka nytt meddelande -->
                <div class="col-md-5 mb-4">
                    <div class="card shadow-sm border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Skicka meddelande</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Till (Mottagarens användarnamn):</label>
                                <input @bind="newMessage.ReceiverName" class="form-control" placeholder="T.ex. Admin eller Användare" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Meddelande:</label>
                                <textarea @bind="newMessage.Content" class="form-control" rows="5"></textarea>
                            </div>
                            <button class="btn btn-primary w-100" @onclick="SkickaMeddelande">
                                <i class="bi bi-send"></i> Skicka
                            </button>
                            
                            @if (meddelandeSkickat)
                            {
                                <div class="alert alert-success mt-3 mb-0">Meddelandet har skickats!</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Höger sida: Inkorg -->
                <div class="col-md-7">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Inkorg (@myMessages.Count)</h5>
                        </div>
                        <div class="card-body p-0">
                            @if (myMessages.Count == 0)
                            {
                                <div class="p-5 text-center text-muted">
                                    <i class="bi bi-envelope-open" style="font-size: 3rem;"></i>
                                    <p class="mt-2">Du har inga meddelanden ännu.</p>
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var msg in myMessages)
                                    {
                                        <li class="list-group-item p-3 border-bottom">
                                            <div class="d-flex justify-content-between mb-2">
                                                <strong class="text-primary"><i class="bi bi-person-fill"></i> Från: @msg.SenderName</strong>
                                                <small class="text-muted">@msg.SentAt.ToString("yyyy-MM-dd HH:mm")</small>
                                            </div>
                                            <p class="mb-0" style="white-space: pre-wrap;">@msg.Content</p>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning mt-4">
            Du måste <a href="/login">logga in</a> för att se dina meddelanden.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<PrivateMessage> myMessages = new List<PrivateMessage>();
    private PrivateMessage newMessage = new PrivateMessage();
    private string currentUserName = "";
    private bool meddelandeSkickat = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            currentUserName = authState.User.Identity.Name ?? "";
            LaddaInkorg();
        }
    }

    private void LaddaInkorg()
    {
        if (!string.IsNullOrEmpty(currentUserName))
        {
            myMessages = MessageRepo.GetMessagesForUser(currentUserName);
        }
    }

    private async Task SkickaMeddelande()
    {
        if (string.IsNullOrWhiteSpace(newMessage.ReceiverName) || string.IsNullOrWhiteSpace(newMessage.Content))
        {
            return;
        }

        newMessage.SenderName = currentUserName;
        newMessage.SentAt = DateTime.Now;

        MessageRepo.SendMessage(newMessage);

        newMessage = new PrivateMessage();
        meddelandeSkickat = true;
        
        // Uppdaterad, säkrare metod för fördröjning i Blazor
        StateHasChanged();
        await Task.Delay(3000);
        meddelandeSkickat = false;
        StateHasChanged();
    }
    }
}