@page "/admin/kategorier"
@using PublicCMS.Core.Models
@using PublicCMS.Web.Repositories
@inject ICategoryRepository CategoryRepo
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<h3>Hantera Forumkategorier</h3>

<div class="card mb-4 p-3">
    <h4>Skapa nytt övergripande ämne</h4>
    <div class="mb-2">
        <label>Rubrik (t.ex. Fordonssnack):</label>
        <input @bind="newCategory.Name" class="form-control" />
    </div>
    <div class="mb-2">
        <label>Beskrivning (Frivillig):</label>
        <input @bind="newCategory.Description" class="form-control" />
    </div>
    <button class="btn btn-primary" @onclick="SaveCategory">Spara ämne</button>
</div>

<h4>Befintliga ämnen</h4>
<ul class="list-group">
    @foreach (var c in categories)
    {
        <li class="list-group-item">
            <strong>@c.Name</strong> - @c.Description
        </li>
    }
</ul>

@code {
    private Category newCategory = new Category();
    private List<Category> categories = new List<Category>();

    protected override void OnInitialized()
    {
        categories = CategoryRepo.GetAll();
    }

    private void SaveCategory()
    {
        CategoryRepo.Add(newCategory);
        newCategory = new Category(); // för återställer formuläret
        categories = CategoryRepo.GetAll(); //det för Ladda om listan så det nya ämnet syns
    }
}