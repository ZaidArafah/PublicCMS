@page "/"
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@inject IPageRepository PageRepo

<PageTitle>Start sida</PageTitle>

<h1>Välkommen till min nya hemsida!</h1>
<p>Här är de sidor som finns publicerade just nu:</p>

<div class="list-group mt-4">
    @foreach (var p in pages)
    {
        <a href="/sida/@p.Id" class="list-group-item list-group-item-action">
            @p.Title
        </a>
    }
</div>

@code {
    private List<Page> pages = new List<Page>();

    protected override void OnInitialized()
    {
        // Hämtar alla sidor, men soterar bort de som inte är publicerade
        pages = PageRepo.GetAll().Where(p => p.IsPublished == true).ToList();
    }
}