@page "/admin/redigera-sida/{Id:int}"
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@inject IPageRepository PageRepo
@inject NavigationManager NavManager
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<h3>Redigera sida</h3>

@if (editPage != null)
{
    <div class="mb-3">
        <label>Rubrik:</label>
        <input @bind="editPage.Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Text:</label>
        <textarea @bind="editPage.Bodytext" class="form-control"></textarea>
    </div>


    <div class="mb-3 form-check">
        <input type="checkbox" @bind="editPage.IsPublished" class="form-check-input" id="editPub" />
        <label class="form-check-label" for="editPub">Sidan ska vara publicerad och synlig</label>
    </div>

    <button class="btn btn-success" @onclick="SaveChanges">Spara ändringar</button>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Page editPage;

    protected override void OnInitialized()
    {
        editPage = PageRepo.GetById(Id);
    }

    private void SaveChanges()
    {
        PageRepo.Update(editPage);
        NavManager.NavigateTo("/admin/sidor");
    }
}