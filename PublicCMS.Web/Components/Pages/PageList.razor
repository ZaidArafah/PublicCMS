@page "/admin/sidor"
@using PublicCMS.Core.Models
@using PublicCMS.Core.Repositories
@inject IPageRepository PageRepo



<h3>Alla Sidor</h3>

<table class="table">
    <thead>
        <tr>
            <th>id</th>
            <th>Rubrik</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in pages)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Title</td>

                <td>
                    <a href="/admin/redigera-sida/@p.Id" class="btn btn-warning btn-sm">Ändra</a>
                    <button class="btn btn-danger btn-sm" @onclick="() => DeletePage(p.Id)">Ta bort</button>
                </td>
            </tr>
        }
    </tbody>
</table>


@code {
    private List<Page> pages = new List<Page>();

    protected override void OnInitialized()
    {
        pages = PageRepo.GetAll();
    }

    private void DeletePage(int id)
    {
        PageRepo.Delete(id);
        pages = PageRepo.GetAll(); // Uppdatera listan efter borttagning
    }
}
